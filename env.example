# Email Service (Server-side only - DO NOT expose to client)
RESEND_API_KEY=your_resend_api_key_here

# Telegram (Server-side only)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_RESERVATIONS_CHAT_ID=your_chat_id_here
TELEGRAM_CHAT_ID=your_waiter_chat_id_here
TELEGRAM_DISABLE=false

# Google Sheets (Server-side only — used for QR table sessions)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# QR menu table signing (Server-side only)
QR_MENU_SECRET=change_me_to_a_long_random_secret

# VIP / Admin secret link for /masa (Server-side only)
# Share `https://<site>/masa?vip=<this-secret>` with admins/VIPs.
# Rotate to invalidate all distributed links. Min 24 chars.
VIP_MENU_SECRET=change_me_to_a_long_random_secret_at_least_24_chars

# Mapbox (Client-side - requires NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# OpenTable (if needed)
NEXT_PUBLIC_OPENTABLE_RESTAURANT_ID=your_restaurant_id_here

# Form Services
NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/YOUR_FORM_ID

# Mailchimp
NEXT_PUBLIC_MAILCHIMP_URL=your_mailchimp_url_here
NEXT_PUBLIC_MAILCHIMP_KEY=your_mailchimp_key_here
