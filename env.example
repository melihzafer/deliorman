# Email Service (Server-side only - DO NOT expose to client)
RESEND_API_KEY=your_resend_api_key_here

# Telegram (Server-side only)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_RESERVATIONS_CHAT_ID=-1003678849881
TELEGRAM_DISABLE=false

# Mapbox (Client-side - requires NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# OpenTable (if needed)
NEXT_PUBLIC_OPENTABLE_RESTAURANT_ID=your_restaurant_id_here

# Form Services
NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/YOUR_FORM_ID

# Mailchimp
NEXT_PUBLIC_MAILCHIMP_URL=your_mailchimp_url_here
NEXT_PUBLIC_MAILCHIMP_KEY=your_mailchimp_key_here

# ============================
# AI Menu Assistant (server-side only — DO NOT expose to client)
# ============================
# Anthropic API key from https://platform.claude.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional overrides
# AI_MODEL=claude-opus-4-8
# AI_MAX_TOKENS=1024
# AI_RATE_WINDOW_SECONDS=600
# AI_RATE_MAX=20

# ============================
# QR Code System
# ============================
# Maximum table number allowed in generated QR codes
# QR_TABLE_LIMIT=100
# QR endpoint throttling
# QR_RATE_WINDOW_SECONDS=60
# QR_RATE_MAX=120
